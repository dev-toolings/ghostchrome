# Binaries (anchored to repo root so they don't shadow .claude/skills/ghostchrome/)
/ghostchrome
/ghostchrome-mcp
# Build output. Anchored to the repo root so the release binaries CI drops in
# `/dist/` stay out of the index, while `/dist/npm/` (the six versioned npm
# distribution manifests) stays tracked: it is release metadata, not output.
# `sdk/typescript/dist/` is covered by sdk/typescript/.gitignore.
/dist/*
!/dist/npm/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets — never commit env files (a committed .env carried a trojan on origin)
.env
.env.*
!.env.example

# Go
*.exe
*.test
*.out

# Bun workspace (root store + per-package symlink trees)
node_modules/
*.tsbuildinfo

# Python SDK artifacts
__pycache__/
*.pyc
sdk/python/.venv/
sdk/python/*.egg-info/

# ig index
.ig/

# Recipes / config — local-only YAML dropped at the repo root.
# Deliberately NOT `*.yaml`: that ignored every YAML file at every level and
# would silently swallow CI, deploy and tool configs (the workflows survive
# today only because they are `.yml`). Private recipe YAML lives inside the
# `/packages/<site>/` directories ignored at the bottom of this file.
/*.yaml

# Playwright
.playwright*

# Benchmark transient artifacts (regenerated by ./benchmark/run-bench.sh)
benchmark/trials/
benchmark/.fixtures.log
benchmark/.serve.log
benchmark/results.json
benchmark/results-warm.json
/bin/

# crew worktrees (transient, per-task isolation)
.claude/worktrees/

# Private scraping recipes — kept on disk, never committed.
# Composed into the binary only via `go build -tags recipes ./cmd/ghostchrome`
# (build tag already excludes them from the default binary).
/packages/leboncoin/
/packages/linkedin/
/packages/instagram/
/packages/cars-listings/
/packages/websearch/
/internal/surface/cli/leboncoin.go
/internal/surface/cli/linkedin.go
/internal/surface/cli/instagram.go
/internal/surface/cli/cars_listings.go
/internal/surface/cli/websearch.go
/internal/surface/cli/websearch_mcp.go

# Documentation of the private recipes above: the commands they describe are
# gitignored and built only with `-tags recipes`, so their manuals stay local
# too. The rest of `docs/` is versioned.
/docs/websearch.md
/docs/recipes/autoscout24.md
